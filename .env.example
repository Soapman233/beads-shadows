# Documentation only: start.ps1 does not automatically load this file.
# Set process environment variables before starting the backend.
BEAD_AI_ENABLED=0
DASHSCOPE_API_KEY=
BEAD_BAILIAN_ENDPOINT=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# MySQL platform mode. Leave blank for the existing local guest editor.
BEAD_DATABASE_URL=
# Set to your exact frontend origin when using a development proxy.
BEAD_WEB_ORIGIN=
# Set to 1 on an HTTPS deployment.
BEAD_COOKIE_SECURE=0
BEAD_ASSET_DIR=
# Opt in only in an isolated local demo. These modes are distinct from live services.
BEAD_MOCK_PAYMENTS=0
BEAD_AI_SIMULATION=0
BEAD_AI_PLATFORM_LIVE=0
BEAD_DEVELOPMENT_OUTBOX=
BEAD_SMTP_HOST=
BEAD_SMTP_PORT=465
BEAD_SMTP_FROM=
BEAD_SMTP_USER=
BEAD_SMTP_PASSWORD=
